<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Assigninc — Digital Marketing & Social Media Growth</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;900&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#14150F;
    --white:#FFFFFF;
    --lime:#C6F135;
    --lime-deep:#9FCB1B;
    --grey-bg:#F4F4F1;
    --text-muted:#6C6D66;
    --line:#E5E5DF;
    --radius:20px;
    --max:1180px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--white);
    color:var(--ink);
    font-family:'Open Sans',sans-serif;
    -webkit-font-smoothing:antialiased;
    line-height:1.5;
  }
  h1,h2,h3,h4{
    font-family:'Roboto',sans-serif;
    letter-spacing:-0.02em;
    color:var(--ink);
  }
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 24px;}
  .mono{
    font-family:'Roboto',sans-serif;
    text-transform:uppercase;
    letter-spacing:0.08em;
    font-size:12px;
    font-weight:600;
  }
  :focus-visible{outline:2px solid var(--ink);outline-offset:3px;}

  /* BUTTONS */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    font-family:'Roboto',sans-serif;
    font-weight:600;
    font-size:13.5px;
    letter-spacing:0.02em;
    padding:16px 26px;
    border-radius:100px;
    border:none;
    cursor:pointer;
    transition:transform .18s ease, background .18s ease;
    white-space:nowrap;
  }
  .btn-primary{
    background:var(--ink);
    color:var(--white);
  }
  .btn-primary:hover{background:#000;transform:translateY(-2px);}
  .btn-lime{
    background:var(--lime);
    color:var(--ink);
  }
  .btn-lime:hover{background:var(--lime-deep);transform:translateY(-2px);}
  .btn-ghost{
    background:transparent;
    color:var(--ink);
    border:1.5px solid var(--line);
  }
  .btn-ghost:hover{border-color:var(--ink);}
  .btn-sm{padding:11px 18px;font-size:12px;}

  .highlight{
    background:var(--lime);
    padding:2px 8px;
    border-radius:6px;
    display:inline;
  }

  /* TOPBAR */
  .topbar{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .topbar-inner{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 24px;
  }
  .logo{
    font-family:'Roboto',sans-serif;
    font-weight:700;
    font-size:20px;
    display:flex;align-items:center;gap:9px;
  }
  .logo-mark{
    width:28px;height:28px;border-radius:8px;
    background:var(--ink);
    position:relative;
  }
  .logo-mark::after{
    content:'';
    position:absolute;left:7px;top:12px;
    width:12px;height:6px;
    border-left:2.5px solid var(--lime);
    border-bottom:2.5px solid var(--lime);
    transform:rotate(-45deg);
  }
  .topbar-cta{display:flex;align-items:center;gap:18px;}
  .phone-link{font-size:14px;font-weight:600;display:none;}
  @media(min-width:720px){.phone-link{display:block;}}

  /* HERO */
  .hero{padding:64px 0 40px;}
  .hero-grid{
    display:grid;grid-template-columns:1fr;gap:48px;align-items:center;
  }
  @media(min-width:960px){.hero-grid{grid-template-columns:1.05fr 0.95fr;gap:40px;}}
  h1.headline{
    font-size:clamp(34px,5.4vw,56px);
    line-height:1.06;
    font-weight:700;
    margin-bottom:20px;
  }
  .sub{
    font-size:16.5px;
    color:var(--text-muted);
    max-width:480px;
    margin-bottom:30px;
  }
  .hero-cta-row{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:0;}

  /* HERO ILLUSTRATION */
  .hero-illust{
    position:relative;
    min-height:420px;
    display:flex;align-items:center;justify-content:center;
  }

  /* HERO CARD STACK */
  .card-stack{
    position:relative;
    width:100%;max-width:380px;height:400px;
  }
  .stack-card{
    position:absolute;
    top:46px;
    width:220px;height:290px;
    border-radius:24px;
    padding:24px;
    display:flex;flex-direction:column;justify-content:space-between;
    box-shadow:0 30px 55px -22px rgba(20,21,15,0.4);
    opacity:0;
  }
  .stack-icon{
    width:40px;height:40px;border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    background:rgba(255,255,255,0.18);
  }
  .stack-card.bright .stack-icon{background:rgba(20,21,15,0.14);}
  .stack-eyebrow{
    font-family:'Roboto',sans-serif;font-weight:700;font-size:11.5px;
    letter-spacing:0.08em;text-transform:uppercase;
    color:rgba(255,255,255,0.8);margin-bottom:10px;
  }
  .stack-card.bright .stack-eyebrow{color:rgba(20,21,15,0.65);}
  .stack-headline{font-size:19px;font-weight:700;line-height:1.2;color:var(--white);}
  .stack-card.bright .stack-headline{color:var(--ink);}
  .stack-stat-num{font-family:'Roboto',sans-serif;font-weight:700;font-size:26px;color:var(--white);}
  .stack-card.bright .stack-stat-num{color:var(--ink);}
  .stack-stat-label{font-size:12px;color:rgba(255,255,255,0.75);margin-top:2px;}
  .stack-card.bright .stack-stat-label{color:rgba(20,21,15,0.65);}

  .card-a{
    left:0;z-index:1;
    background:linear-gradient(155deg,#14150F,#2A2C21);
    animation:fanInA .8s cubic-bezier(.22,1,.36,1) .05s forwards, shuffleA 9s ease-in-out 1.1s infinite;
  }
  .card-b.bright{
    left:78px;top:14px;z-index:3;
    background:linear-gradient(155deg,#C6F135,#9FCB1B);
    animation:fanInB .8s cubic-bezier(.22,1,.36,1) .2s forwards, shuffleB 9s ease-in-out 1.1s infinite;
  }
  .card-c{
    right:0;left:auto;z-index:2;
    background:linear-gradient(155deg,#1E2118,#14150F);
    animation:fanInC .8s cubic-bezier(.22,1,.36,1) .35s forwards, shuffleC 9s ease-in-out 1.1s infinite;
  }

  @keyframes fanInA{
    from{opacity:0;transform:translateY(26px) rotate(0deg) scale(.92);}
    to{opacity:1;transform:translateY(0) rotate(-9deg) scale(1);}
  }
  @keyframes fanInB{
    from{opacity:0;transform:translateY(26px) rotate(0deg) scale(.92);}
    to{opacity:1;transform:translateY(0) rotate(-2deg) scale(1);}
  }
  @keyframes fanInC{
    from{opacity:0;transform:translateY(26px) rotate(0deg) scale(.92);}
    to{opacity:1;transform:translateY(0) rotate(9deg) scale(1);}
  }

  /* Each card takes a turn stepping to the front of the stack */
  @keyframes shuffleA{
    0%,88%,100%{transform:translateY(0) rotate(-9deg) scale(1);z-index:1;}
    4%{transform:translateY(-26px) rotate(-2deg) scale(1.1);z-index:5;}
    16%{transform:translateY(0) rotate(-9deg) scale(1);z-index:1;}
  }
  @keyframes shuffleB{
    0%,33%,49%,100%{transform:translateY(0) rotate(-2deg) scale(1);z-index:3;}
    37%{transform:translateY(-28px) rotate(2deg) scale(1.1);z-index:5;}
  }
  @keyframes shuffleC{
    0%,66%,82%,100%{transform:translateY(0) rotate(9deg) scale(1);z-index:2;}
    70%{transform:translateY(-26px) rotate(3deg) scale(1.1);z-index:5;}
  }

  @media(max-width:420px){
    .stack-card{width:82vw;max-width:220px;}
  }
  @media(prefers-reduced-motion:reduce){
    .stack-card{animation:none !important;opacity:1;}
    .card-a{transform:rotate(-9deg);}
    .card-b.bright{transform:rotate(-2deg);}
    .card-c{transform:rotate(9deg);}
  }

  /* LOGO/STATS STRIP */
  .stats-bar{
    padding:36px 0;
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    margin-top:20px;
  }
  .stats-grid{
    display:grid;grid-template-columns:repeat(2,1fr);gap:24px;
    text-align:center;
  }
  @media(min-width:720px){.stats-grid{grid-template-columns:repeat(4,1fr);}}
  .stat-num{font-family:'Roboto',sans-serif;font-weight:700;font-size:28px;color:var(--ink);}
  .stat-label{font-size:12.5px;color:var(--text-muted);margin-top:4px;}

  /* TRUSTED BY MARQUEE */
  .trusted-section{
    padding:64px 0 76px;
    text-align:center;
  }
  .trusted-label{
    font-size:14px;color:var(--text-muted);
    margin-bottom:36px;
    letter-spacing:0.1em;
  }
  .marquee-rows{
    display:flex;flex-direction:column;gap:32px;
  }
  .marquee{
    position:relative;
    overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
  }
  .marquee-track{
    display:flex;
    align-items:center;
    width:max-content;
    gap:60px;
    animation:scrollLeft 60s linear infinite;
  }
  .marquee-track.reverse{
    animation-direction:reverse;
  }
  .marquee:hover .marquee-track{animation-play-state:paused;}
  @keyframes scrollLeft{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }
  .brand-logo{
    display:flex;align-items:center;justify-content:center;
    height:76px;
    flex-shrink:0;
    opacity:0.55;
    filter:grayscale(1);
    transition:opacity .2s ease, filter .2s ease;
  }
  .brand-logo:hover{opacity:1;filter:grayscale(0);}
  .brand-logo img{
    height:48px;
    width:auto;
    max-width:180px;
    object-fit:contain;
    display:block;
  }
  @media(min-width:720px){
    .brand-logo{height:88px;}
    .brand-logo img{height:56px;max-width:200px;}
  }
  @media(prefers-reduced-motion:reduce){
    .marquee-track{animation:none;}
  }

  /* SECTION */
  .section{padding:88px 0;}
  .section-head{
    display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:flex-start;
    margin-bottom:44px;
  }
  .section-tag{
    display:inline-flex;align-items:center;
    background:var(--lime);
    padding:8px 16px;
    border-radius:100px;
    font-family:'Roboto',sans-serif;
    font-weight:600;
    font-size:15px;
    height:fit-content;
  }
  .section-head p{color:var(--text-muted);font-size:15px;max-width:420px;}
  .section-head h2{font-size:clamp(26px,3.4vw,36px);font-weight:700;}
  .section-head-title{
    display:flex;align-items:center;gap:18px;flex-wrap:wrap;
  }

  /* SERVICES */
  .services-grid{
    display:grid;grid-template-columns:1fr;gap:20px;
  }
  @media(min-width:760px){.services-grid{grid-template-columns:1fr 1fr;}}
  .service-card{
    border-radius:var(--radius);
    padding:32px;
    position:relative;
    min-height:250px;
    display:flex;flex-direction:column;justify-content:space-between;
    transition:transform .2s ease;
    overflow:hidden;
  }
  .service-card:hover{transform:translateY(-4px);}
  .service-card.light{background:var(--white);border:1.5px solid var(--ink);}
  .service-card.dark{background:var(--ink);color:var(--white);}
  .service-card h3{font-size:22px;font-weight:600;margin-bottom:0;line-height:1.2;}
  .service-card h3 span{
    background:var(--lime);color:var(--ink);
    padding:2px 8px;border-radius:6px;
    box-decoration-break:clone;
    -webkit-box-decoration-break:clone;
  }
  .service-desc{
    font-size:14px;
    color:var(--text-muted);
    max-width:300px;
    margin-top:12px;
  }
  .service-card.dark .service-desc{color:#B9BAB2;}
  .service-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;}
  .service-icon{
    width:56px;height:56px;
    border-radius:14px;
    display:flex;align-items:center;justify-content:center;
    font-size:26px;
    flex-shrink:0;
  }
  .service-card.light .service-icon{background:var(--grey-bg);}
  .service-card.dark .service-icon{background:rgba(255,255,255,0.08);}
  .service-link{
    display:inline-flex;align-items:center;gap:8px;
    font-size:13.5px;font-weight:600;
    margin-top:20px;
  }
  .service-link .arrow{
    width:26px;height:26px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:13px;
  }
  .service-card.light .arrow{background:var(--lime);color:var(--ink);}
  .service-card.dark .arrow{background:var(--lime);color:var(--ink);}

  /* PROCESS */
  .process-strip{
    display:grid;grid-template-columns:1fr;gap:0;
    border-top:1px solid var(--line);
  }
  @media(min-width:820px){.process-strip{grid-template-columns:repeat(4,1fr);}}
  .process-step{
    padding:24px 22px 24px 0;
    border-bottom:1px solid var(--line);
  }
  @media(min-width:820px){
    .process-step{border-right:1px solid var(--line);border-bottom:none;padding:24px 22px;}
    .process-step:last-child{border-right:none;}
  }
  .process-num{
    font-family:'Roboto',sans-serif;
    font-size:13px;color:var(--lime-deep);
    margin-bottom:14px;
  }
  .process-step h4{font-size:17px;font-weight:600;margin-bottom:8px;}
  .process-step p{font-size:13.5px;color:var(--text-muted);}

  /* CTA BANNER */
  .cta-banner{
    background:var(--grey-bg);
    border-radius:26px;
    padding:56px 40px;
    display:flex;flex-wrap:wrap;
    align-items:center;justify-content:space-between;
    gap:28px;
    position:relative;
    overflow:hidden;
  }
  .cta-banner-text{position:relative;z-index:2;max-width:440px;}
  .cta-banner h2{font-size:clamp(24px,3vw,32px);margin-bottom:10px;}
  .cta-banner p{color:var(--text-muted);font-size:15px;margin-bottom:22px;}
  .cta-blob{
    position:relative;z-index:2;
    flex-shrink:0;
    width:140px;height:140px;
  }

  /* CASE STUDIES */
  .case-grid{display:grid;grid-template-columns:1fr;gap:18px;}
  @media(min-width:820px){.case-grid{grid-template-columns:repeat(3,1fr);}}
  .case-card{
    background:var(--ink);
    color:var(--white);
    border-radius:var(--radius);
    padding:30px;
    display:flex;flex-direction:column;
    justify-content:space-between;
    min-height:250px;
  }
  .case-result{
    font-family:'Roboto',sans-serif;
    font-size:34px;font-weight:700;color:var(--lime);margin-bottom:10px;
  }
  .case-card p.body{font-size:14px;color:#B9BAB2;margin-bottom:20px;}
  .case-link{font-size:13px;font-weight:600;color:var(--lime);display:inline-flex;gap:6px;align-items:center;}

  /* REELS CASE STUDIES */
  .reels-head{
    display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:flex-end;
    margin-bottom:28px;
  }
  .reels-scroll-hint{font-size:12.5px;color:var(--text-muted);display:flex;align-items:center;gap:6px;}
  @media(min-width:900px){.reels-scroll-hint{display:none;}}
  .reels-track{
    display:flex;gap:16px;
    overflow-x:auto;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
    padding:4px 4px 14px;
    margin:0 -4px;
    scrollbar-width:none;
  }
  .reels-track::-webkit-scrollbar{display:none;}
  @media(min-width:900px){
    .reels-track{display:grid;grid-template-columns:repeat(4,1fr);overflow:visible;padding:0;margin:0;}
  }
  .reel-card{
    scroll-snap-align:start;
    flex:0 0 72%;
    max-width:260px;
    aspect-ratio:9/16;
    border-radius:22px;
    position:relative;
    overflow:hidden;
    background:linear-gradient(155deg,#1B1E27,#0E0F0A);
    box-shadow:0 14px 30px rgba(0,0,0,0.18);
  }
  @media(min-width:520px){.reel-card{flex-basis:46%;}}
  @media(min-width:900px){.reel-card{flex-basis:auto;max-width:none;}}
  .reel-card.g2{background:linear-gradient(155deg,#22261A,#0E0F0A);}
  .reel-card.g3{background:linear-gradient(155deg,#1A1D14,#111208);}
  .reel-card.g4{background:linear-gradient(155deg,#1E2118,#0C0D08);}
  .reel-progress{
    position:absolute;top:12px;left:12px;right:12px;
    display:flex;gap:4px;z-index:3;
  }
  .reel-progress span{flex:1;height:2.5px;border-radius:2px;background:rgba(255,255,255,0.28);}
  .reel-progress span.active{background:var(--lime);}
  .reel-topbar{
    position:absolute;top:22px;left:12px;right:12px;z-index:3;
    display:flex;align-items:center;gap:8px;
  }
  .reel-avatar{
    width:22px;height:22px;border-radius:50%;
    background:var(--lime);
    display:flex;align-items:center;justify-content:center;
    font-family:'Roboto',sans-serif;font-weight:700;font-size:10px;color:var(--ink);
    flex-shrink:0;
  }
  .reel-handle{font-size:11.5px;color:#fff;font-weight:600;}
  .reel-play{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:52px;height:52px;border-radius:50%;
    background:rgba(255,255,255,0.14);
    backdrop-filter:blur(4px);
    display:flex;align-items:center;justify-content:center;
    z-index:2;
  }
  .reel-play::after{
    content:'';
    border-style:solid;
    border-width:9px 0 9px 15px;
    border-color:transparent transparent transparent #ffffff;
    margin-left:3px;
  }
  .reel-bg-icon{
    position:absolute;inset:0;
    display:flex;align-items:center;justify-content:center;
    opacity:0.16;
  }
  .reel-bottom{
    position:absolute;left:0;right:0;bottom:0;z-index:3;
    padding:16px 14px 16px;
    background:linear-gradient(to top, rgba(0,0,0,0.85), transparent);
  }
  .reel-stat-badge{
    display:inline-flex;align-items:center;gap:5px;
    background:var(--lime);color:var(--ink);
    font-family:'Roboto',sans-serif;font-weight:700;font-size:12.5px;
    padding:4px 9px;border-radius:100px;
    margin-bottom:10px;
  }
  .reel-caption{
    color:#fff;font-size:13.5px;font-weight:600;line-height:1.35;margin-bottom:8px;
  }
  .reel-meta{
    display:flex;gap:14px;
    font-size:11.5px;color:#D9DAD3;
  }
  .reel-meta span{display:flex;align-items:center;gap:4px;}

  /* TESTIMONIALS */
  .testimonials-grid{
    display:grid;grid-template-columns:1fr;gap:18px;
  }
  @media(min-width:760px){.testimonials-grid{grid-template-columns:repeat(3,1fr);}}
  .testimonial-card{
    background:var(--grey-bg);
    border-radius:var(--radius);
    padding:28px;
    display:flex;flex-direction:column;
    justify-content:space-between;
    min-height:230px;
  }
  .stars{display:flex;gap:3px;margin-bottom:16px;}
  .stars svg{width:17px;height:17px;flex-shrink:0;}
  .testimonial-quote{
    font-size:15px;line-height:1.55;color:var(--ink);margin-bottom:24px;
  }
  .testimonial-person{display:flex;align-items:center;gap:12px;}
  .testimonial-avatar{
    width:40px;height:40px;border-radius:50%;
    background:var(--ink);color:var(--lime);
    display:flex;align-items:center;justify-content:center;
    font-family:'Roboto',sans-serif;font-weight:700;font-size:14px;
    flex-shrink:0;
  }
  .testimonial-name{font-size:13.5px;font-weight:600;}
  .testimonial-role{font-size:12px;color:var(--text-muted);}

  /* ASK COMPARISON */
  .ask-grid{
    display:grid;grid-template-columns:1fr;gap:20px;
  }
  @media(min-width:900px){.ask-grid{grid-template-columns:1fr 1fr;}}
  .ask-panel{
    border-radius:var(--radius);
    padding:36px 34px;
  }
  .ask-panel.light{background:var(--grey-bg);}
  .ask-panel.dark{background:var(--ink);}
  .ask-panel-head{
    display:flex;align-items:center;gap:12px;
    margin-bottom:28px;
  }
  .ask-panel-head h3{font-size:19px;font-weight:700;}
  .ask-panel.dark .ask-panel-head h3{color:var(--white);}
  .ask-icon{
    width:32px;height:32px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;font-size:14px;
  }
  .ask-panel.light .ask-icon{background:var(--line);color:var(--text-muted);}
  .ask-panel.dark .ask-icon{background:var(--lime);color:var(--ink);}
